# Copy to `.env` or `.env.local` and adjust (see https://vite.dev/guide/env-and-mode.html).
# Variables prefixed with `VITE_` are exposed to client code via `import.meta.env`.

# -----------------------------------------------------------------------------
# Dev server proxy (read by vite.config.ts only — not bundled into the app)
# -----------------------------------------------------------------------------
# Where `/langgraph` requests are forwarded.
# `langgraph up` (Docker) binds to http://127.0.0.1:8123 by default.
# Use 127.0.0.1 rather than localhost — Node 18+ resolves localhost to ::1 (IPv6).
# VITE_LANGGRAPH_PROXY_TARGET=http://127.0.0.1:8123

# -----------------------------------------------------------------------------
# LangGraph SDK client (optional — read by src/lib/langgraphClient.ts)
# -----------------------------------------------------------------------------
# Leave unset to use the relative URL `/langgraph` (works with the proxy above).
# Set a full URL only if you are calling the Agent Server directly and have CORS configured.
# VITE_LANGGRAPH_API_URL=http://127.0.0.1:8123
